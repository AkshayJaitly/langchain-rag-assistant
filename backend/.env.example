# Generation provider: "anthropic" (Claude, paid API) or "ollama" (local, free).
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=2048

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Sonnet 5 = balanced; claude-haiku-4-5 = cheapest; claude-opus-5 = highest quality.
LLM_MODEL=claude-sonnet-5

# --- Ollama (used when LLM_PROVIDER=ollama; $0, runs locally) ---
# Install Ollama, then: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Local embedding model (runs offline via sentence-transformers, no API cost).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Persistence directories (created automatically).
CHROMA_DIR=./data/chroma
DOCSTORE_DIR=./data/docstore
UPLOAD_DIR=./data/uploads

# Parent-child chunking sizes (characters).
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50

# Retrieval
RETRIEVAL_K=4

# CORS origins for the frontend (comma-separated).
CORS_ORIGINS=http://localhost:5173
