# Provider: "anthropic" (Claude) | "openai" (GPT) | "groq" (free/fast) | "ollama" (local/free).
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=2048

# Pipeline: "simple" (retrieve -> generate) or "multi_agent"
# (grader + generator + verifier agents with one corrective revision).
PIPELINE=simple

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Sonnet 5 = balanced; claude-haiku-4-5 = cheapest; claude-opus-5 = highest quality.
LLM_MODEL=claude-sonnet-5

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Groq (used when LLM_PROVIDER=groq; FREE tier at https://console.groq.com) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (used when LLM_PROVIDER=ollama; $0, runs locally) ---
# Install Ollama, then: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- LangSmith tracing / observability (optional) ---
# Get a key at https://smith.langchain.com → Settings → API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENVIRONMENT=development
# Safe defaults: traces include graph structure/timing but not document content.
# Set to false only for non-sensitive data when inspecting prompts and answers.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Local embedding model (runs offline via sentence-transformers, no API cost).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Persistence directories (created automatically).
CHROMA_DIR=./data/chroma
DOCSTORE_DIR=./data/docstore
UPLOAD_DIR=./data/uploads

# Parent-child chunking sizes (characters).
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50

# Retrieval
RETRIEVAL_K=4

# CORS origins for the frontend (comma-separated).
CORS_ORIGINS=http://localhost:5173
